# Secrets
.env

# Data — FinAccess .dta is licensed, never commit
data/raw/*
!data/raw/.gitkeep

# Virtual environment
.venv/

# Experiment results (regenerable; keep the folder, not the outputs)
experiments/**/results/*
!experiments/**/results/.gitkeep
# Exception: benchmark outputs are dissertation evidence, not scratch
!experiments/**/results/bakeoff.json
!experiments/**/results/prep_profile*.json
# NOTE: modelling_frame*.csv is derived from licensed FinAccess microdata
# and stays ignored. Only aggregate profiles are committed.

# Model / dataset caches
.hf_cache/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
