# Secrets
.env

# Data — nothing under data/ is committable except the files named below.
# FinAccess .dta is licensed; codebook and slices in data/explore/ are
# derived from it; audio is personal data.
data/**
# Re-include directories so the exceptions below can match (git cannot
# re-include a file whose parent directory is excluded).
!data/**/
!data/README.md
!data/raw/.gitkeep
# Text index of the audio set: versioned, the audio itself is not
!data/manifest.csv

# Audio — interview recordings of identifiable people. Personal data under
# the Kenya Data Protection Act 2019; never committable, anywhere in the tree.
*.wav
*.m4a
*.mp3
*.flac
*.ogg

# Signed consent forms — held offline only. This repository is public.
docs/consent/

# Trained model artefacts, including the OpenVINO ASR exports (models/*-ov-*/)
models/
models/*-ov-*/

# Frontend dependencies
node_modules/

# Virtual environment
.venv/

# Experiment results (regenerable; keep the folder, not the outputs)
experiments/**/results/*
!experiments/**/results/.gitkeep
# Exception: benchmark outputs are dissertation evidence, not scratch
!experiments/**/results/bakeoff.json
!experiments/**/results/prep_profile*.json
!experiments/**/results/model_results*.json
!experiments/**/results/borrower_profile.json
# borrower_frame.csv stays ignored: derived from licensed microdata
# NOTE: modelling_frame*.csv is derived from licensed FinAccess microdata
# and stays ignored. Only aggregate profiles are committed.

# Model / dataset caches
.hf_cache/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Derived exports from licensed survey data
data/explore/
models/*.joblib
data/assessment.json
data/features_raw.txt
docs/Kikuyu_Recording_Worksheet.pdf

# database backups and SQLite side files
*.db.*
*.db-wal
*.db-shm
*.bak
