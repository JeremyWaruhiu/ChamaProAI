# Copy this file to .env and fill in values. Never commit .env.

# Google AI Studio key — used for Gemini (translation candidate 1, later feature extraction)
GOOGLE_API_KEY=

# Hugging Face token — needed to download the gated FLORES+ dataset
HF_TOKEN=

# GhanaNLP Khaya key — translation candidate 3, only if Kikuyu is supported
KHAYA_API_KEY=

# Optional: where Hugging Face caches models/datasets. Defaults to <project>/.hf_cache
# HF_HOME=

# Optional: OAuth 2.0 Web client ID for "Sign in with Google" on the dashboard
# (Google Cloud Console > APIs & Services > Credentials). Leave blank to hide
# the button; username/password sign-in works either way. See README "Users".
GOOGLE_CLIENT_ID=

# --- Speech recognition ------------------------------------------------------
# Kikuyu ASR. OpenVINO runs the int8 export from scripts/export_openvino.py;
# without it (or with ASR_ENGINE=torch) the torch model ASR_MODEL is used.
# A missing GPU falls back to the CPU. /api/health reports what was used.
# ASR_ENGINE=openvino
# ASR_DEVICE=GPU
# ASR_OV_MODEL_DIR=models/paza-ov-int8
# ASR_MODEL=microsoft/paza-whisper-large-v3-turbo
# ASR_LANGUAGE=sw
# timestamps (default) or plain; compare them with scripts/benchmark_asr.py first.
# ASR_DECODING=timestamps
# Generation cap: 16 + this many tokens per second of audio.
# ASR_TOKENS_PER_SECOND=12
# English interviews: loaded the first time an English answer is transcribed.
# ASR_EN_OV_MODEL_DIR=models/whisper-en-ov-int8
# ASR_EN_MODEL=openai/whisper-large-v3-turbo

# --- Database ----------------------------------------------------------------
# Unset: SQLite at data/chamapro.db (CHAMAPRO_DB moves it), migrated at startup.
# Supabase: the Session pooler connection string (Connect > Session pooler), then
# `alembic upgrade head` before starting the API. See README "Switching to Supabase".
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Interview audio storage -------------------------------------------------
# local (default): data/uploads/. supabase: a PRIVATE bucket, replayed through
# signed URLs that expire after SUPABASE_SIGNED_URL_SECONDS.
# STORAGE_BACKEND=local
# SUPABASE_URL=https://<project-ref>.supabase.co
# The service-role key bypasses every access rule. Server side only: never in
# the frontend, never committed, never in a VITE_ variable.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=interview-audio
# SUPABASE_SIGNED_URL_SECONDS=120
